{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NullTweaker",
  "version": "0.1.0",
  "identifier": "io.nulltweaker.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "NullTweaker",
        "width": 1060,
        "height": 740,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
